{
  "name": "Industrial",
  "author": "Stu",

  "variables": {
    "bg":        "#121316",
    "fg":        "#d0d4dc",
    "fg_bright": "#e0e2e6",
    "sel":       "#2a2c33",
    "cursor":    "#8b929a",
    "line_hl":   "#1a1c21",
    "comment":   "#5a6070",
    "guide":     "#383c47",

    "red":       "#bf565e",
    "red_dim":   "#a3484e",
    "green":     "#62826c",
    "green_dim": "#506b58",
    "yellow":    "#bf9d6f",
    "yellow_dim":"#a8895e",
    "blue":      "#566c82",
    "blue_dim":  "#46586b",
    "magenta":   "#825f73",
    "cyan":      "#587b82",
    "white":     "#a0a4ab"
  },

  "globals": {
    "background": "var(bg)",
    "foreground": "var(fg)",
    "caret": "var(cursor)",
    "block_caret": "var(cursor)",
    "selection": "var(sel)",
    "selection_foreground": "var(fg_bright)",
    "line_highlight": "var(line_hl)",
    "gutter": "var(bg)",
    "gutter_foreground": "var(guide)",
    "gutter_foreground_highlight": "var(white)",
    "guide": "var(guide)",
    "active_guide": "var(white)",
    "find_highlight": "var(yellow_dim)",
    "find_highlight_foreground": "var(bg)",
    "brackets_foreground": "var(yellow)",
    "brackets_options": "underline",
    "bracket_contents_foreground": "var(yellow_dim)",
    "bracket_contents_options": "underline"
  },

  "rules": [
    { "scope": "comment, punctuation.definition.comment", "foreground": "var(comment)", "font_style": "italic" },
    { "scope": "string, punctuation.definition.string", "foreground": "var(green)" },
    { "scope": "constant.character.escape", "foreground": "var(cyan)" },
    { "scope": "constant.numeric", "foreground": "var(magenta)" },
    { "scope": "constant.language, constant.other", "foreground": "var(yellow_dim)" },
    { "scope": "keyword, storage.modifier", "foreground": "var(red)" },
    { "scope": "keyword.operator", "foreground": "var(white)" },
    { "scope": "storage.type", "foreground": "var(cyan)" },
    { "scope": "entity.name.function, variable.function, support.function", "foreground": "var(yellow)" },
    { "scope": "entity.name.type, entity.name.class, entity.name.struct, entity.name.enum, support.type, support.class", "foreground": "var(cyan)" },
    { "scope": "entity.name.macro, support.macro, variable.function.macro", "foreground": "var(blue)" },
    { "scope": "storage.modifier.lifetime, entity.name.lifetime", "foreground": "var(magenta)", "font_style": "italic" },
    { "scope": "variable.parameter", "foreground": "var(fg)", "font_style": "italic" },
    { "scope": "variable.language", "foreground": "var(red_dim)", "font_style": "italic" },
    { "scope": "punctuation, meta.brace", "foreground": "var(white)" },
    { "scope": "entity.name.tag", "foreground": "var(red)" },
    { "scope": "entity.other.attribute-name", "foreground": "var(yellow)" },
    { "scope": "meta.annotation, meta.attribute", "foreground": "var(blue)" },
    { "scope": "markup.heading", "foreground": "var(yellow)", "font_style": "bold" },
    { "scope": "markup.bold", "font_style": "bold" },
    { "scope": "markup.italic", "font_style": "italic" },
    { "scope": "markup.inserted", "foreground": "var(green)" },
    { "scope": "markup.deleted", "foreground": "var(red)" },
    { "scope": "invalid", "foreground": "var(fg_bright)", "background": "var(red_dim)" }
  ]
}
